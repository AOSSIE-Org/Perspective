# Perspective frontend environment variables. Copy to .env.local (git-ignored) and adjust.

# Base URL of the Perspective FastAPI backend. Defaults to the hosted Hugging Face Space when unset;
# use http://localhost:8000 when running the backend locally.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this site, used for canonical URLs, the sitemap and social previews.
# Defaults to https://perspective.aossie.org when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
