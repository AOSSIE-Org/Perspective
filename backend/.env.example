# ==============================================================================
# Perspective Backend - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# 1. Groq API Key
# Used for LLM inference (bias detection, sentiment analysis, counter-perspective generation, judging)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Pinecone API Key
# Used for vector database storage and retrieval (RAG chat)
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# 3. Google Custom Search Engine Key
# Used for real-time fact checking via web search
SEARCH_KEY=your_google_search_api_key_here

# 4. Backend Server Port (Default: 8000 for local dev, 7860 for Hugging Face Spaces)
PORT=8000

# 5. Hugging Face Access Token
# Required if deploying backend to Hugging Face Spaces (needs 'Write' permissions)
# Optional for local downloads from Hugging Face Hub (public model weights download without token)
# Create token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_access_token_here
